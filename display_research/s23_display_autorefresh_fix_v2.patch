+  /* Disable TPG FIFO and restore DSI_COMMAND_MODE_DMA_CTRL */
+  Wr32 (DSI0_TPG_MAIN_CONTROL, 0U);
+  Wr32 (DSI0_TPG_DMA_FIFO_RESET, 1U);
+  gBS->Stall (2);
+  Wr32 (DSI0_TPG_DMA_FIFO_RESET, 0U);
+  Wr32 (DSI0_CMD_MODE_DMA_CTRL, SavedDmaCtrl);
+  return Done;
+}
