+  /* Push command DWORDs; hardware requires trailing zero DWORD for odd counts */
+  for (I = 0; I < NumDwords; I++) {
+    Wr32 (DSI0_TPG_DMA_FIFO_DATA, Dwords[I]);
+  }
+  if ((NumDwords & 1U) != 0U) {
+    Wr32 (DSI0_TPG_DMA_FIFO_DATA, 0U);
