+STATIC BOOLEAN
+Dsi0SendTpgFifoPkt (
+  IN CONST UINT32  *Dwords,
+  IN UINT32        NumDwords
+  )
+{
+  UINT32   SavedDmaCtrl;
+  UINT32   DmaCtrl;
+  UINT32   IntCtrl;
+  UINT32   FinalInt = 0;
+  UINT32   I;
+  BOOLEAN  Done = FALSE;
+
+  if (!Dsi0WaitIdle ()) {
+    return FALSE;
+  }
+
+  SavedDmaCtrl = Rd32 (DSI0_CMD_MODE_DMA_CTRL);
+
+  /* Cleanly reset TPG FIFO before loading */
+  Wr32 (DSI0_TPG_MAIN_CONTROL, 0U);
+  Wr32 (DSI0_TPG_DMA_FIFO_RESET, 1U);
+  gBS->Stall (2);
+  Wr32 (DSI0_TPG_DMA_FIFO_RESET, 0U);
+
+  /* CMD_DMA_TPG_EN (BIT1) | TPG_DMA_FIFO_MODE (BIT2) | custom pattern (3 << 16) */
+  Wr32 (DSI0_TPG_MAIN_CONTROL, (1U << 1) | (1U << 2) | (3U << 16));
