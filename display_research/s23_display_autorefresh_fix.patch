+++ b/Platforms/Samsung/dm1qPkg/Drivers/S23DisplayFixDxe/S23DisplayFixDxe.c
@@ -0,0 +1,174 @@
+/** @file
+  S23DisplayFixDxe - Samsung Galaxy S23 (dm1q / SM8550-AC) Command-Mode Display Auto-Refresh Keeper.
+
+  Ensures the DM1_S6E3FAC_AMB606AW01 DSI command-mode panel stays actively refreshed
+  across UEFI boot and ExitBootServices handoff into Windows 11 SimpleFB (0xB8000000),
+  strictly gated by DISP_CC GDSC + AHB/MDP clock checks (G116Gate) to avoid AXI SErrors.
+**/
+
+#include <Uefi.h>
+#include <Guid/EventGroup.h>
+#include <Library/ArmLib.h>
+#include <Library/DebugLib.h>
+#include <Library/IoLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+#define DISP_CC_BASE                      0x0AF00000ULL
+#define DISP_CC_MDSS_CORE_GDSCR           (DISP_CC_BASE + 0x9000ULL)
+#define DISP_CC_MDSS_MDP_CLK_CBCR         (DISP_CC_BASE + 0x800CULL)
+#define DISP_CC_MDSS_AHB_CLK_CBCR         (DISP_CC_BASE + 0x80A4ULL)
+
+#define MDSS_HW_VERSION                   0x0AE00000ULL
+#define MDP_CTL_0_START                   0x0AE1601CULL
+#define MDP_INTF_1_FRAME_COUNT            0x0AE360ACULL
+#define MDP_INTF_1_TEAR_CHECK_EN          0x0AE36284ULL
+#define MDP_INTF_1_AUTOREFRESH_CONFIG     0x0AE362B4ULL
+
+/* Bit 31 = ENABLE, bits [15:0] = FRAME_COUNT (2 -> 60 Hz refresh from 120 Hz TE) */
+#define AUTOREFRESH_ENABLE_60HZ           0x80000002U
+
+STATIC EFI_EVENT  mRefreshTimer = NULL;
+STATIC EFI_EVENT  mExitBootEvent = NULL;
+STATIC UINT32     mLastFrameCount = 0;
+STATIC BOOLEAN    mHaveFrameSample = FALSE;
+
+STATIC
+BOOLEAN
+IsMdssPoweredAndClocked (
+  VOID
+  )
+{
+  UINT32  Gdscr;
+  UINT32  AhbCbcr;
+  UINT32  MdpCbcr;
+
+  ArmDataMemoryBarrier ();
+  Gdscr   = MmioRead32 ((UINTN)DISP_CC_MDSS_CORE_GDSCR);
+  AhbCbcr = MmioRead32 ((UINTN)DISP_CC_MDSS_AHB_CLK_CBCR);
+  MdpCbcr = MmioRead32 ((UINTN)DISP_CC_MDSS_MDP_CLK_CBCR);
+  ArmDataMemoryBarrier ();
+
+  if ((Gdscr & 0x80000000U) == 0) {
+    return FALSE;
+  }
+  if ((AhbCbcr & 0x80000000U) != 0) {
+    return FALSE;
+  }
+  if ((MdpCbcr & 0x80000000U) != 0) {
+    return FALSE;
+  }
+  return TRUE;
+}
+
+STATIC
+VOID
+RearmAutoRefreshAndKick (
+  IN BOOLEAN  ForceKick
+  )
+{
+  UINT32  HwVer;
+  UINT32  AutoRef;
+  UINT32  TearEn;
+  UINT32  FrameCnt;
+
+  if (!IsMdssPoweredAndClocked ()) {
+    return;
+  }
+
+  ArmDataMemoryBarrier ();
+  HwVer = MmioRead32 ((UINTN)MDSS_HW_VERSION);
+  if ((HwVer == 0U) || (HwVer == 0xFFFFFFFFU)) {
+    return;
+  }
+
+  TearEn   = MmioRead32 ((UINTN)MDP_INTF_1_TEAR_CHECK_EN);
+  AutoRef  = MmioRead32 ((UINTN)MDP_INTF_1_AUTOREFRESH_CONFIG);
+  FrameCnt = MmioRead32 ((UINTN)MDP_INTF_1_FRAME_COUNT);
+
+  if (ForceKick || ((TearEn & 1U) == 0U) || ((AutoRef & 0x80000000U) == 0U) ||
+      (mHaveFrameSample && (FrameCnt == mLastFrameCount)))
+  {
+    MmioWrite32 ((UINTN)MDP_INTF_1_TEAR_CHECK_EN, 1U);
+    MmioWrite32 ((UINTN)MDP_INTF_1_AUTOREFRESH_CONFIG, AUTOREFRESH_ENABLE_60HZ);
+    ArmDataMemoryBarrier ();
+    MmioWrite32 ((UINTN)MDP_CTL_0_START, 1U);
+    ArmDataMemoryBarrier ();
+  }
+
+  mLastFrameCount  = FrameCnt;
+  mHaveFrameSample = TRUE;
+}
+
+STATIC
+VOID
+EFIAPI
+OnRefreshTimer (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  (VOID)Event;
+  (VOID)Context;
+  RearmAutoRefreshAndKick (FALSE);
+}
+
+STATIC
+VOID
+EFIAPI
+OnExitBootServices (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  (VOID)Event;
+  (VOID)Context;
+
+  if (mRefreshTimer != NULL) {
+    gBS->SetTimer (mRefreshTimer, TimerCancel, 0);
+  }
+
+  RearmAutoRefreshAndKick (TRUE);
+}
+
+EFI_STATUS
+EFIAPI
+S23DisplayFixEntryPoint (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+
+  (VOID)ImageHandle;
+  (VOID)SystemTable;
+
+  if (IsMdssPoweredAndClocked ()) {
+    DEBUG ((DEBUG_INFO, "S23DisplayFixDxe: MDSS gate open (HW_VER=0x%08X), arming Auto-Refresh\n",
+      MmioRead32 ((UINTN)MDSS_HW_VERSION)));
+    RearmAutoRefreshAndKick (TRUE);
+  } else {
+    DEBUG ((DEBUG_WARN, "S23DisplayFixDxe: MDSS GDSC/clocks off at DXE entry; skipping MMIO\n"));
+  }
+
+  Status = gBS->CreateEvent (
+                  EVT_TIMER | EVT_NOTIFY_SIGNAL,
+                  TPL_CALLBACK,
+                  OnRefreshTimer,
+                  NULL,
+                  &mRefreshTimer
+                  );
+  if (!EFI_ERROR (Status)) {
+    gBS->SetTimer (mRefreshTimer, TimerPeriodic, 330000ULL);
+  }
+
+  gBS->CreateEventEx (
+         EVT_NOTIFY_SIGNAL,
+         TPL_NOTIFY,
+         OnExitBootServices,
+         NULL,
+         &gEfiEventExitBootServicesGuid,
+         &mExitBootEvent
+         );
+
+  return EFI_SUCCESS;
+}
