[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %MfgName%
DriverVer   = 11/23/2026,1.0.0.6
CatalogFile = s23audio.cat
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
s23audio.sys = 1,,

[DestinationDirs]
S23Audio.CopyList = 13

[Manufacturer]
%MfgName% = S23Audio, NTarm64

[S23Audio.NTarm64]
%S23Audio.DeviceDesc% = S23Audio_Inst, ROOT\S23AUDIO
%S23Audio.DeviceDesc% = S23Audio_Inst, ACPI\S23AUD01
%S23Audio.DeviceDesc% = S23Audio_Inst, ACPI\S23A8550

[S23Audio_Inst.NT]
Include   = ks.inf,wdmaudio.inf
Needs     = KS.Registration,WDMAUDIO.Registration
CopyFiles = S23Audio.CopyList
AddReg    = S23Audio.AddReg

[S23Audio.CopyList]
s23audio.sys

[S23Audio.AddReg]
HKR,,AssociatedFilters,,"wdmaud,redbook"
HKR,,Driver,,s23audio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%S23Audio.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%S23Audio.DeviceDesc%

[S23Audio_Inst.NT.HW]
AddReg = S23Audio.Security.AddReg

[S23Audio.Security.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[S23Audio_Inst.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveSpeaker%, S23Audio.I.WaveSpeaker
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveSpeaker%, S23Audio.I.WaveSpeaker
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, S23Audio.I.WaveSpeaker
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopoSpeaker%, S23Audio.I.TopoSpeaker
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopoSpeaker%, S23Audio.I.TopoSpeaker

[S23Audio.I.WaveSpeaker]
AddReg = S23Audio.I.WaveSpeaker.AddReg

[S23Audio.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%S23Audio.WaveSpeaker.FriendlyName%

[S23Audio.I.TopoSpeaker]
AddReg = S23Audio.I.TopoSpeaker.AddReg

[S23Audio.I.TopoSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%S23Audio.TopoSpeaker.FriendlyName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_FormFactor%,0x00010001,0x00000001
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x00000001
HKR,EP\0,%PKEY_AudioEngine_OEMFormat%,0x00000001,41,00,00,00,28,00,00,00,FE,FF,02,00,80,BB,00,00,00,EE,02,00,04,00,10,00,16,00,10,00,03,00,00,00,01,00,00,00,00,00,10,00,80,00,00,AA,00,38,9B,71

[S23Audio_Inst.NT.Services]
AddService = s23audio, 0x00000002, S23Audio_Service_Inst

[S23Audio_Service_Inst]
DisplayName   = %S23Audio.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\s23audio.sys

[Strings]
MfgName                           = "Samsung Galaxy S23 WoA"
DiskName                          = "S23 Native Audio Driver Disk"
S23Audio.DeviceDesc               = "Samsung Galaxy S23 Stereo"
S23Audio.SvcDesc                  = "Samsung Galaxy S23 AudioReach PortCls Driver"
S23Audio.WaveSpeaker.FriendlyName = "Samsung Galaxy S23 Stereo Wave"
S23Audio.TopoSpeaker.FriendlyName = "Samsung Galaxy S23 Stereo"

KSNAME_WaveSpeaker                = "WaveSpeaker"
KSNAME_TopoSpeaker                = "TopoSpeaker"
Proxy.CLSID                       = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO                  = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER                 = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME               = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY               = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY                    = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_FormFactor                = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},0"
PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
PKEY_AudioEngine_OEMFormat                   = "{E4870E26-3CC5-4CD2-BA46-CA0A9A70ED04},3"
