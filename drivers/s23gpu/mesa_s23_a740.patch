+
+struct fd_wddm_kmt_ctx {
+   D3DKMT_HANDLE hAdapter;
+   D3DKMT_HANDLE hDevice;
+   PFND3DKMT_ESCAPE pfnEscape;
+};
+
+static int
+fd_wddm_kmt_escape(void *ctx, void *data, unsigned size)
+{
+   struct fd_wddm_kmt_ctx *k = (struct fd_wddm_kmt_ctx *)ctx;
+   D3DKMT_ESCAPE ke;
+   memset(&ke, 0, sizeof(ke));
+   ke.hAdapter = k->hAdapter;
+   ke.hDevice = k->hDevice;
+   ke.Type = D3DKMT_ESCAPE_DRIVERPRIVATE;
+   ke.pPrivateDriverData = data;
+   ke.PrivateDriverDataSize = size;
+   return k->pfnEscape(&ke) >= 0 ? 0 : -1;
+}
+
+int
+fd_wddm_open_kmt(void)
+{
+   static struct fd_wddm_kmt_ctx s_kmt;
+   static int s_fd = -1;
+   if (s_fd >= 0)
+      return s_fd;
+
+   HMODULE hGdi = GetModuleHandleA("gdi32.dll");
+   if (!hGdi)
+      hGdi = LoadLibraryA("gdi32.dll");
+   if (!hGdi)
+      return -1;
+
+   PFND3DKMT_ENUMADAPTERS3 pEnum3 = (PFND3DKMT_ENUMADAPTERS3)GetProcAddress(hGdi, "D3DKMTEnumAdapters3");
+   PFND3DKMT_ENUMADAPTERS2 pEnum2 = (PFND3DKMT_ENUMADAPTERS2)GetProcAddress(hGdi, "D3DKMTEnumAdapters2");
+   PFND3DKMT_QUERYADAPTERINFO pQuery = (PFND3DKMT_QUERYADAPTERINFO)GetProcAddress(hGdi, "D3DKMTQueryAdapterInfo");
+   PFND3DKMT_CREATEDEVICE pCreateDev = (PFND3DKMT_CREATEDEVICE)GetProcAddress(hGdi, "D3DKMTCreateDevice");
+   PFND3DKMT_CLOSEADAPTER pClose = (PFND3DKMT_CLOSEADAPTER)GetProcAddress(hGdi, "D3DKMTCloseAdapter");
+   PFND3DKMT_ESCAPE pEsc = (PFND3DKMT_ESCAPE)GetProcAddress(hGdi, "D3DKMTEscape");
+   if (!pQuery || !pCreateDev || !pClose || !pEsc || (!pEnum3 && !pEnum2))
+      return -1;
+
+   D3DKMT_ADAPTERINFO infos[32];
+   ULONG count = 0;
+   if (pEnum3) {
+      D3DKMT_ENUMADAPTERS3 e3;
+      memset(&e3, 0, sizeof(e3));
+      e3.Filter.IncludeComputeOnly = 1;
+      e3.Filter.IncludeDisplayOnly = 1;
+      e3.NumAdapters = 32;
+      e3.pAdapters = infos;
+      if (pEnum3(&e3) >= 0)
+         count = e3.NumAdapters;
+   }
+   if (count == 0 && pEnum2) {
+      D3DKMT_ENUMADAPTERS2 e2;
+      memset(&e2, 0, sizeof(e2));
+      e2.NumAdapters = 32;
+      e2.pAdapters = infos;
+      if (pEnum2(&e2) >= 0)
+         count = e2.NumAdapters;
+   }
+
+   D3DKMT_HANDLE found = 0;
+   for (ULONG i = 0; i < count; i++) {
+      ULONG magic = 0;
+      D3DKMT_QUERYADAPTERINFO q;
+      memset(&q, 0, sizeof(q));
+      q.hAdapter = infos[i].hAdapter;
+      q.Type = KMTQAITYPE_UMDRIVERPRIVATE;
+      q.pPrivateDriverData = &magic;
+      q.PrivateDriverDataSize = sizeof(magic);
+      if (pQuery(&q) >= 0 && magic == TOPAZGPU_ESC_MAGIC && found == 0) {
+         found = infos[i].hAdapter;
+      } else {
+         D3DKMT_CLOSEADAPTER ca = { infos[i].hAdapter };
+         pClose(&ca);
+      }
+   }
+   if (!found)
+      return -1;
+
+   D3DKMT_CREATEDEVICE cd;
+   memset(&cd, 0, sizeof(cd));
+   cd.hAdapter = found;
+   if (pCreateDev(&cd) < 0) {
+      D3DKMT_CLOSEADAPTER ca = { found };
+      pClose(&ca);
+      return -1;
+   }
+
+   s_kmt.hAdapter = found;
+   s_kmt.hDevice = cd.hDevice;
+   s_kmt.pfnEscape = pEsc;
+   s_fd = fd_wddm_open(fd_wddm_kmt_escape, &s_kmt);
+   return s_fd;
+}
