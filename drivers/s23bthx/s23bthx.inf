; s23bthx.inf - Samsung Galaxy S23 (dm1q) QCA6490 Native Bluetooth 5.3 BTHX LowerFilter
[Version]
Signature   = "$WINDOWS NT$"
Class       = Bluetooth
ClassGuid   = {e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider    = %ProviderName%
DriverVer   = 04/01/2024,1.0.0.6
CatalogFile = s23bthx.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
s23bthx.sys = 1

[Manufacturer]
%ManufacturerName% = Models,NTARM64

[Models.NTARM64]
%DeviceName% = S23Bthx_Device, ROOT\S23BTHX

[S23Bthx_Device.NT]
Include   = Bth.inf
Needs     = BthMini.NT
CopyFiles = S23Bthx_Copy

[S23Bthx_Copy]
s23bthx.sys

[S23Bthx_Device.NT.HW]
Include = Bth.inf
Needs   = BthMini.NT.HW
AddReg  = S23Bthx_HW_AddReg

[S23Bthx_HW_AddReg]
HKR,,"LowerFilters",0x00010000,"s23bthx"

[S23Bthx_Device.NT.Services]
Include    = Bth.inf
Needs      = BthMini.NT.Services
AddService = s23bthx, , S23Bthx_Service_Inst

[S23Bthx_Service_Inst]
DisplayName   = %ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\s23bthx.sys

[Strings]
ProviderName     = "S23 Windows Bringup"
ManufacturerName = "Samsung Galaxy S23"
DiskName         = "S23 Bluetooth 5.3 Transport Driver Disk"
DeviceName       = "Samsung Galaxy S23 QCA6490 Bluetooth 5.3"
ServiceDesc      = "S23 QCA6490 Bluetooth UART BTHX LowerFilter Driver"
